# BackOffice reusa el MISMO proyecto de Supabase que tuDeclaracion (mismo backend, misma DB).
# Copiar este archivo a .env y completar con las credenciales reales del proyecto.

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only, NUNCA exponer al browser) ---
# Usado exclusivamente por src/infrastructure/supabase/service.ts en server actions.
# Ver ADR-0002 (.context/ADR/ADR-0002-service-role-client-bypasses-rls.md).
SUPABASE_SERVICE_ROLE_KEY=

# Project ref usado por `bun run supabase:types` para generar src/types/supabase.ts
SUPABASE_PROJECT_ID=

# --- Acceso admin (ver ADR-0001) ---
# Lista de emails autorizados a entrar al backoffice, separados por coma.
ADMIN_EMAILS=
